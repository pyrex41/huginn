#!/bin/sh
# Spawned by Claude Code as an MCP stdio channel. Loopback inject only.
# Project .mcp.json uses server:huginn → this script. Plugin installs use
# ${CLAUDE_PLUGIN_ROOT}/run-channel.
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
repo=$(CDPATH= cd -- "$root/../.." && pwd)

if [ -z "${HUGINN_TOKEN:-}" ]; then
  if [ -f "$repo/.huginn-token" ]; then
    HUGINN_TOKEN=$(sed -n '1p' "$repo/.huginn-token")
    export HUGINN_TOKEN
  fi
fi
: "${HUGINN_ADDR:=127.0.0.1:7419}"
export HUGINN_ADDR

if [ -x "$root/bin/huginn-channel" ]; then
  exec "$root/bin/huginn-channel" "$@"
fi
if [ -x "$repo/bin/huginn-channel" ]; then
  exec "$repo/bin/huginn-channel" "$@"
fi
if command -v huginn-channel >/dev/null 2>&1; then
  exec huginn-channel "$@"
fi
echo "huginn-channel: binary not found; from the huginn repo run: make build" >&2
exit 1

